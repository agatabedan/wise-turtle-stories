# Local port. Render sets PORT automatically.
PORT=3000

# MailerLite API token.
# MailerLite -> Integrations -> API -> Generate new token
# Paste the raw token only, without "Bearer".
MAILERLITE_API_TOKEN=PASTE_YOUR_TOKEN_HERE

# MailerLite group ID where website subscribers should go.
# MailerLite -> Subscribers -> Groups -> open/create a group, then copy its id.
# If you know the token but not the group id, run: npm run check:mailerlite
MAILERLITE_GROUP_ID=PASTE_YOUR_GROUP_ID_HERE

# MailerLite group that triggers the Life After Journey confirmation email.
MAILERLITE_JOURNEY_GROUP_ID=PASTE_YOUR_JOURNEY_GROUP_ID_HERE

# Allowed website origin for CORS.
# Use the real domain in production, for example:
# FRONTEND_ORIGIN=https://wiseturtlestories.com,https://www.wiseturtlestories.com
FRONTEND_ORIGIN=http://localhost:5500

# Optional Postgres database connection string.
# For Render, create a Postgres database and copy either the internal or external DATABASE_URL here.
DATABASE_URL=PASTE_DATABASE_URL_HERE

# Set to true only if your Postgres provider requires SSL.
DATABASE_SSL=false

# Private token for owner-only review contact export.
# Generate a long random value and keep it secret.
ADMIN_TOKEN=PASTE_LONG_RANDOM_ADMIN_TOKEN_HERE
